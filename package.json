{
  "name": "riyada-node-backend",
  "version": "1.1.0",
  "description": "باك إند حجز الملاعب — Node.js + Express (تخزين في الذاكرة أو MongoDB)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test:admin": "node tests/admin-backend-smoke.js",
    "test:backend": "node --test tests/backend-*.test.js && node tests/admin-backend-smoke.js",
    "test:mongo-integration": "node --test tests/backend-mongo-integration.test.js",
    "test": "npm run test:backend",
    "migrate:dry-run": "node scripts/migrate-production-data.js",
    "migrate:apply": "node scripts/migrate-production-data.js --apply",
    "migrate:rollback": "node scripts/migrate-production-data.js --rollback",
    "build": "npm --prefix web-admin install --no-audit --no-fund && npm --prefix web-admin run build && node scripts/copy-admin.js && npm --prefix web install --no-audit --no-fund && npm --prefix web run build:deploy",
    "build:admin": "npm --prefix web-admin run build && node scripts/copy-admin.js",
    "build:web": "npm --prefix web run build:deploy"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "socket.io": "^4.8.3"
  },
  "optionalDependencies": {
    "@sentry/node": "^10.66.0",
    "firebase-admin": "^14.2.0"
  }
}
