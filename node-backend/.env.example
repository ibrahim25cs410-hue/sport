# Copy to .env for local development (never commit .env to Git)

# Required in production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sports-booking?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
NODE_ENV=production

# Optional
PORT=3000

# Notes:
# - Development: omit MONGODB_URI to use in-memory storage (data resets on restart).
# - Development: omit JWT_SECRET to use a dev-only secret (console warning).
# - Socket.io shares the same HTTP server and port as the REST API.
