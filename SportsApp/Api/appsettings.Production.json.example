{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=/var/data/riyada.db"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_32_CHAR_MINIMUM_SECRET_KEY",
    "Issuer": "Riyada",
    "Audience": "RiyadaApp",
    "ExpireHours": 72
  },
  "PaymentGateways": {
    "ZainCash": {
      "MerchantId": "",
      "Secret": "",
      "Msisdn": "",
      "BaseUrl": "https://api.zaincash.iq"
    },
    "Card": {
      "MerchantId": "",
      "Secret": "",
      "BaseUrl": ""
    }
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Bookings": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Payments": { "PermitLimit": 15, "WindowSeconds": 60 }
  }
}
