<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Firebase iOS config template.
  1. Firebase Console → iOS app (iq.riyada.riyada)
  2. Download GoogleService-Info.plist
  3. Copy to: mobile/ios/Runner/GoogleService-Info.plist
  OR run: flutterfire configure
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>YOUR_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>YOUR_SENDER_ID</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:YOUR_SENDER_ID:ios:YOUR_APP_ID</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project-id</string>
	<key>BUNDLE_ID</key>
	<string>iq.riyada.riyada</string>
</dict>
</plist>
