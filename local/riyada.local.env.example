# Copy to local/riyada.local.env — loaded by run.bat
# Do not commit real secrets to git.

# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://0.0.0.0:61082

# Firebase Admin SDK — path to service account JSON on your laptop
# Fcm__CredentialsPath=D:\sport\secrets\firebase-service-account.json
# Fcm__ProjectId=your-firebase-project-id

# Optional: override JWT for team testing
# Jwt__Key=your-team-shared-secret-at-least-32-characters-long
