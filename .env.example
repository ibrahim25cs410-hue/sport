# Copy to .env for local development (never commit .env)

# Required in production (Render Environment)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sports-booking?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
NODE_ENV=production

# Optional
PORT=3000

# Comma-separated browser origins for CORS (recommended in production)
# Example: https://riyada.iq,https://www.riyada.iq,http://localhost:5173
ALLOWED_ORIGINS=

# Notes:
# - Development: omit MONGODB_URI to use in-memory storage (data resets on restart).
# - Production: JWT_SECRET must be 32+ characters or the process exits.
# - Dangerous wipe routes are permanently disabled (410 Gone).
# - Socket.io runs on the same HTTP server/port.
