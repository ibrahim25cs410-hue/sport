# Copy to .env for local development (never commit .env)

# Required in production (Render Environment)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sports-booking?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
NODE_ENV=production

# Optional
PORT=3000
# Cash-only launch mode. Set true later when a real gateway is connected and tested.
ELECTRONIC_PAYMENTS_ENABLED=false

# Comma-separated browser origins for CORS (recommended in production)
# Example: https://riyada.iq,https://www.riyada.iq,http://localhost:5173
ALLOWED_ORIGINS=

# Admin seeding — creates/promotes an admin account on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=مدير المنصة
# One-time promote of an existing account via POST /api/admin/bootstrap { email, secret }
ADMIN_BOOTSTRAP_SECRET=

# FCM push (optional) — paste the Firebase service account JSON (raw or base64)
# If unset, realtime works via Socket.io only (no background push).
FIREBASE_SERVICE_ACCOUNT=

# Notes:
# - Development: omit MONGODB_URI to use in-memory storage (data resets on restart).
# - Production: JWT_SECRET should be 32+ chars; otherwise a secret is derived from MONGODB_URI.
# - Dangerous wipe routes are permanently disabled (410 Gone).
# - Socket.io runs on the same HTTP server/port.
