# Copy to /etc/riyada/riyada.env and chmod 600
# ASP.NET Core maps __ to nested config (e.g. Jwt__Key)

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000

# PostgreSQL (production) — use strong password; create DB and user first
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=riyada;Username=riyada;Password=CHANGE_ME_STRONG_PASSWORD

# Generate: openssl rand -base64 48
Jwt__Key=CHANGE_ME_USE_openssl_rand_base64_48
Jwt__Issuer=Riyada
Jwt__Audience=Riyada
Jwt__ExpireHours=72

# Comma-separated web origins (mobile apps use Bearer token, not CORS)
Cors__AllowedOrigins__0=https://riyada.iq
Cors__AllowedOrigins__1=https://www.riyada.iq
Cors__AllowedOrigins__2=https://app.riyada.iq

# Path to Firebase service account JSON (download from Firebase Console)
Fcm__CredentialsPath=/etc/riyada/firebase-service-account.json
Fcm__ProjectId=your-firebase-project-id

# Payment gateways (optional)
PaymentGateways__ZainCash__BaseUrl=
PaymentGateways__ZainCash__ApiKey=
PaymentGateways__Card__BaseUrl=
PaymentGateways__Card__ApiKey=

# PostgreSQL backup (used by backup-db.sh)
RIYADA_PG_HOST=127.0.0.1
RIYADA_PG_PORT=5432
RIYADA_PG_DB=riyada
RIYADA_PG_USER=riyada
RIYADA_PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
